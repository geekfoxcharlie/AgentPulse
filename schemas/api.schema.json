{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentpulse.local/schemas/api.schema.json",
  "title": "AgentPulse API configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "name", "group", "description", "enabled", "service", "credential", "probe", "usage"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "api" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "group": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "description": { "type": "string", "minLength": 1 },
    "enabled": { "type": "boolean" },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl", "docsUrl"],
      "properties": {
        "baseUrl": { "type": "string", "minLength": 1 },
        "docsUrl": { "type": "string", "minLength": 1 }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "configuredAt", "placement"],
      "properties": {
        "type": { "const": "environment" },
        "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "configuredAt": { "type": "string", "minLength": 1 },
        "placement": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["type", "name"], "properties": { "type": { "const": "header" }, "name": { "type": "string", "minLength": 1 } } },
            { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "bearer" } } },
            { "type": "object", "additionalProperties": false, "required": ["type", "name"], "properties": { "type": { "const": "query" }, "name": { "type": "string", "minLength": 1 } } }
          ]
        }
      }
    },
    "environment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "configuredAt", "description"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "configuredAt": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "placement": {
            "oneOf": [
              { "type": "object", "additionalProperties": false, "required": ["type", "name"], "properties": { "type": { "const": "header" }, "name": { "type": "string", "minLength": 1 } } },
              { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "bearer" } } },
              { "type": "object", "additionalProperties": false, "required": ["type", "name"], "properties": { "type": { "const": "query" }, "name": { "type": "string", "minLength": 1 } } }
            ]
          }
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "url", "expectedStatus", "timeoutMs"],
      "properties": {
        "method": { "enum": ["GET", "POST"] },
        "url": { "type": "string", "minLength": 1 },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "query": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
        "body": { "type": "object" },
        "expectedStatus": { "type": "array", "minItems": 1, "items": { "type": "integer" } },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "exists": { "type": "boolean" },
              "equals": { "type": ["string", "number", "boolean", "null"] }
            }
          }
        },
        "timeoutMs": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notes", "example"],
      "properties": {
        "notes": { "type": "string", "minLength": 1 },
        "example": { "type": "string", "minLength": 1 }
      }
    }
  }
}
