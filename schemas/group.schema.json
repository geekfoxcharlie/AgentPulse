{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentpulse.local/schemas/group.schema.json",
  "title": "AgentPulse group configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "name", "description"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "group" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "order": { "type": "number" }
  }
}
