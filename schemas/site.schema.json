{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentpulse.local/schemas/site.schema.json",
  "title": "AgentPulse site capability configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "name", "group", "description", "enabled", "url", "docsUrl", "login", "usage"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "site" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "group": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "description": { "type": "string", "minLength": 1 },
    "enabled": { "type": "boolean" },
    "url": { "type": "string", "minLength": 1 },
    "docsUrl": { "type": "string", "minLength": 1 },
    "login": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "check"],
      "properties": {
        "required": { "type": "boolean" },
        "check": { "type": "string", "minLength": 1 },
        "loginUrl": { "type": "string", "minLength": 1 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notes", "example"],
      "properties": {
        "notes": { "type": "string", "minLength": 1 },
        "example": { "type": "string", "minLength": 1 }
      }
    }
  }
}
